# Скопируйте этот файл в .env и вставьте свой токен от @BotFather
BOT_TOKEN=123456:AA...сюда_ваш_токен

# Username владельца/гаранта (без @)
OWNER_USERNAME=ws3xx3

# Необязательно: числовой Telegram ID владельца (узнать: @userinfobot)
OWNER_ID=

# Публичный URL для режима webhook (Render подставляет автоматически).
# Если пусто — бот работает в режиме polling (обычный запуск).
PUBLIC_URL=
